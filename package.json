  "private": true,
  "type": "module",
  "description": "石浩田 · AI 产品经理作品集",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local --env-file-if-exists=.env server.js",
